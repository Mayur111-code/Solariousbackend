# Solarious frontend environment template.
# Copy to .env.local for local development and to the host's environment for deploys.
# Every value below is read server-side only. Never move a secret into NEXT_PUBLIC_*.

# --- API connectivity -------------------------------------------------------
# Server-only URL used by the Next.js API proxy. Use an origin only, without /api.
BACKEND_API_URL=http://localhost:4000
# Optional legacy fallback. Leave unset when BACKEND_API_URL is configured.
# VITE_API_URL=

# --- Public site identity ---------------------------------------------------
# Canonical browser origin. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin proxy trust ------------------------------------------------------
# Explicit origins trusted for browser admin writes through the Next.js proxy.
# Comma-separated origins, scheme and port included, no paths.
FRONTEND_ORIGINS=http://localhost:3000

# --- Scheduled reports ------------------------------------------------------
# Required only when the enquiry-report cron route is scheduled.
# Must match CRON_SECRET on the backend service.
# CRON_SECRET=
