# Solarious API environment template.
# Copy to backend/.env (local) or set these as service environment variables.
# The server refuses to boot without MONGODB_URI, ADMIN_USERNAME, ADMIN_PASSWORD
# and FRONTEND_ORIGINS, and prints which optional integrations are configured.

# --- Core API ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/solarious
DB_NAME=solarious
# Comma-separated CORS allow-list. Scheme and port included, no paths.
FRONTEND_ORIGINS=http://localhost:3000
# Business timezone for daily creatives and report periods. Defaults to Asia/Kolkata.
# BUSINESS_TIMEZONE=Asia/Kolkata

# --- Admin authentication ---------------------------------------------------
# ADMIN_PASSWORD also signs admin session cookies: rotating it signs out every admin.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# --- File storage -----------------------------------------------------------
# Production file storage. Required when local uploads are disabled.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Local uploads work outside production only.
LOCAL_UPLOADS_ENABLED=true

# --- Scheduled jobs and reports --------------------------------------------
# Shared bearer secret for the cron endpoints and the frontend report route.
# Required only when reports or daily creatives are scheduled.
# CRON_SECRET=
# Required only for the weekly email report.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=

# --- Creative Studio (Stability AI) ----------------------------------------
# IMAGE_PROVIDER must be "stability" and IMAGE_MODEL "core" or "ultra" for
# text-to-image; other values report capability "unsupported" in /api/health.
# IMAGE_PROVIDER=stability
# IMAGE_MODEL=core
# IMAGE_API_KEY=
# Optional deterministic template, used only after a retryable provider outage.
# Never used for authentication, billing or invalid-request failures.
# FESTIVAL_TEMPLATE_FALLBACK=false

# --- Marketing copy AI ------------------------------------------------------
# APINEX_API_KEY=
# APINEX_BASE_URL=https://api.apinex.bond/v1
# APINEX_MODEL=free/mimo-v2.6-pro

# --- Local-to-Atlas migration (scripts only) -------------------------------
# LOCAL_MONGODB_URI=
# ATLAS_MONGODB_URI=
# ATLAS_EXPECTED_HOST=
# MIGRATION_BACKUP_DIR=
# PUBLIC_SITE_URL=

# --- Smoke test (scripts only) ---------------------------------------------
# API_BASE_URL=http://127.0.0.1:4000
# SMOKE_TEST_ORIGIN=http://localhost:3000
