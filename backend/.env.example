# Solarious API environment template.
# Copy to backend/.env (local) or set these as service environment variables.
# The server refuses to boot without MONGODB_URI, ADMIN_USERNAME, ADMIN_PASSWORD
# and FRONTEND_ORIGINS, and prints which optional integrations are configured.

# --- Core API ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/solarious
DB_NAME=solarious
# Comma-separated CORS allow-list. Scheme and port included, no paths.
FRONTEND_ORIGINS=http://localhost:3000
# Business timezone for daily creatives and report periods. Defaults to Asia/Kolkata.
# BUSINESS_TIMEZONE=Asia/Kolkata

# --- Admin authentication ---------------------------------------------------
# ADMIN_PASSWORD also signs admin session cookies: rotating it signs out every admin.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# --- File storage -----------------------------------------------------------
# Production file storage. Required when local uploads are disabled.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Local uploads work outside production only.
LOCAL_UPLOADS_ENABLED=true

# --- RFQ email notifications (SMTP via Nodemailer) -------------------------
# Preferred over RESEND for RFQ confirmations and sales alerts. When SMTP is
# absent the API falls back to EMAIL_API_KEY/EMAIL_FROM (Resend) if configured.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=commercial@solariousenergy.com
# SMTP_PASS=
# SMTP_FROM=Solarious Energy Procurement Desk <commercial@solariousenergy.com>
# SMTP_REPLY_TO=commercial@solariousenergy.com

# --- RFQ internal routing ---------------------------------------------------
# Comma-separated recipients. Requests of 1 MW and above also copy the
# high-priority inbox and post to the webhook below.
# RFQ_NOTIFICATION_EMAIL=sales-leads@solariousenergy.com
# HIGH_PRIORITY_EMAIL=sales-leads@solariousenergy.com,kam-utility@solariousenergy.com
# Overrides the default four mandatory sales actions in the alert email.
# RFQ_SALES_ACTIONS=Verify GSTIN and credit profile,Check production pipeline,Contact customer within 2 hours,Update the CRM deal record

# --- Optional Slack / Microsoft Teams webhook -------------------------------
# HTTPS incoming-webhook URL. Never expose this value to the frontend.
# SLACK_WEBHOOK_URL=

# --- Scheduled jobs and reports --------------------------------------------
# Shared bearer secret for the cron endpoints and the frontend report route.
# Required only when reports or daily creatives are scheduled.
# CRON_SECRET=
# Required only for the weekly email report.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=Solarious Energy <reports@solariousenergy.com>
# Recipient of the weekly business activity report (default info@solariousenergy.com).
# EMAIL_TO=info@solariousenergy.com
# Optional contact address/link shown in the report footer when no company
# profile is stored in Admin -> Settings.
# REPORT_CONTACT_EMAIL=
# Cron endpoints (all require "Authorization: Bearer $CRON_SECRET"):
#   GET  /api/cron/enquiry-report      legacy alias of the weekly report
#   GET  /api/cron/weekly-report       scheduled run, sends only when due
#   POST /api/cron/weekly-report       same handler for platform schedulers
#   GET  /api/cron/daily-creative      daily 2-3 draft creatives (opt-in)
# A daily trigger is correct: the handler checks the stored seven-day schedule
# and exits with {"skipped":"not_due"} until the period is due.

# --- Creative Studio (image provider) ---------------------------------------
# IMAGE_PROVIDER=stability|openai; IMAGE_MODEL must match the provider:
#   stability  -> core | ultra            (api.stability.ai)
#   openai     -> gpt-image-1 | dall-e-3  (api.openai.com)
# An unknown provider/model reports capability "unsupported" in /api/health and
# the generate endpoint returns 503 without calling the network.
# IMAGE_PROVIDER=stability
# IMAGE_MODEL=core
# IMAGE_API_KEY=
# Optional deterministic template, used only after a retryable provider outage.
# Never used for authentication, billing or invalid-request failures.
# FESTIVAL_TEMPLATE_FALLBACK=false

# --- Marketing copy AI ------------------------------------------------------
# APINEX_API_KEY=
# APINEX_BASE_URL=https://api.apinex.bond/v1
# APINEX_MODEL=free/mimo-v2.6-pro

# --- Local-to-Atlas migration (scripts only) -------------------------------
# LOCAL_MONGODB_URI=
# ATLAS_MONGODB_URI=
# ATLAS_EXPECTED_HOST=
# MIGRATION_BACKUP_DIR=
# PUBLIC_SITE_URL=

# --- Smoke test (scripts only) ---------------------------------------------
# API_BASE_URL=http://127.0.0.1:4000
# SMOKE_TEST_ORIGIN=http://localhost:3000
